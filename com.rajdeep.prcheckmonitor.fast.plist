<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rajdeep.prcheckmonitor.fast</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/run.sh</string>
    <string>--fast</string>
  </array>
  <key>StartInterval</key>
  <integer>20</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO_PATH__/launchd.fast.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_PATH__/launchd.fast.err.log</string>
</dict>
</plist>
